# Normalize line endings. Unity writes its YAML assets (.unity, .prefab,
# .asset, .meta) with LF on every platform, and the Windows checkout was
# converting them to CRLF, so a Windows working copy reported whole-file
# diffs against files it had not touched. Forcing LF for text keeps the diff
# honest about what actually changed.
* text=auto eol=lf

# Unity YAML. Explicit rather than relying on content detection, and marked
# with a merge driver hint so UnityYAMLMerge can be wired in later without
# another attributes change.
*.unity   text eol=lf merge=unityyamlmerge diff
*.prefab  text eol=lf merge=unityyamlmerge diff
*.asset   text eol=lf merge=unityyamlmerge diff
*.meta    text eol=lf merge=unityyamlmerge diff
*.mat     text eol=lf merge=unityyamlmerge diff
*.anim    text eol=lf merge=unityyamlmerge diff
*.controller text eol=lf merge=unityyamlmerge diff

# Windows-only files that genuinely need CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Git LFS. Art assets are multi-megabyte binaries that git stores as a full
# new blob per revision, which is what took this repository past 500 MB.
# Applies to newly committed files only - blobs already in history stay as
# plain objects until a deliberate history rewrite (see NEXT_STEPS_BACKLOG).
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.fbx  filter=lfs diff=lfs merge=lfs -text
*.ttf  filter=lfs diff=lfs merge=lfs -text
*.otf  filter=lfs diff=lfs merge=lfs -text

# Modul: THE RUNTIME AUDIO IS NOT AN LFS ASSET, and shipping it as one made the
# game silent in production for its entire life.
#
# The eleven clips in client/Assets/Resources/Audio are the only audio the game
# serves: FolkIdle.Server.csproj links them into the publish output and
# NetworkBroadcastSystem answers /audio/<name>.wav with them. The Oracle box
# builds the image from a `git pull` of this repository and git-lfs is NOT
# installed there, so the checkout produced 130-byte pointer stubs, the build
# copied those stubs, and the server served them as audio/wav. The browser's
# decodeAudioData rejected them, audio.ts recorded a miss, and nothing anywhere
# logged a word. GitHub Actions checks out without LFS too, so CI could not see
# it either.
#
# 367 KB of small WAVs is not what LFS is for. The ~1 GB that is - the 2048px
# source PNGs under client/Assets/Images/Sprites - stays in LFS above; those
# are never served, the browser gets the WebP resamples.
#
# This rule is LAST because git-attributes is last-match-wins: it overrides the
# blanket *.wav rule for this one directory only. If music ever arrives it will
# be large, will live somewhere else, and can go back into LFS on its own rule.
client/Assets/Resources/Audio/*.wav !filter binary
