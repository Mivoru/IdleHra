# Caddy over nginx+certbot deliberately: it obtains and renews the certificate
# itself and proxies a WebSocket upgrade without any extra configuration, which
# is most of what nginx would have needed hand-written here.
#
# folkidle.duckdns.org is the address to give people. 92-5-0-94.sslip.io is
# kept beside it and is not dead weight: it is how this machine was reachable
# before the name existed, so every link already shared still works, and it
# needs no DNS provider to keep answering. sslip.io resolves any
# A-record-shaped name to the address inside it, which is why it could serve as
# a hostname at all - Let's Encrypt will not issue for a bare IP, the page is
# served over https, and an https page cannot open a ws:// socket.
#
# Caddy obtains a certificate for BOTH names from this one block. The client
# talks to whichever origin served it, so a player on either address stays on
# it; VITE_FOLKIDLE_SERVER in docker-compose.yml decides which one the built
# bundle points its API and WebSocket at, and it is a BUILD ARG - Vite inlines
# it, so changing the address is a rebuild of the web image, never a restart.
#
# Certificate issuance needs port 80 reachable from the internet for the HTTP-01
# challenge - BOTH the instance iptables and the Oracle Security List. Opening
# one and not the other looks exactly like a dead server.
#
# Modul: folkidle.cz, 2026-09-13 - the game's own domain, bought for mail (Resend
# will not verify a duckdns.org or sslip.io name) and served here BESIDE the two
# old names rather than instead of them: the installed APK has
# folkidle.duckdns.org compiled into its bundle, and dropping that name would
# strand every phone until a new build shipped. ADD THIS NAME ONLY ONCE ITS A
# RECORD POINTS AT THIS BOX - Caddy asks Let's Encrypt for a certificate on
# reload, and failed HTTP-01 challenges against a name still parked elsewhere
# count toward the per-hostname failure limit. `www` is served, not redirected,
# for the same no-surprises reason.

folkidle.cz, www.folkidle.cz, folkidle.duckdns.org, 92-5-0-94.sslip.io {
	encode gzip

	# THESE ARE `handle` BLOCKS, AND THAT IS LOAD-BEARING.
	#
	# Caddy orders directives by its own built-in directive order, NOT by the
	# order they appear in the file - and `try_files` sorts BEFORE
	# `reverse_proxy`. Written as bare matchers plus directives, the SPA
	# fallback therefore ran first on every request: `/api/v1/...` and
	# `/gamedata/monsters.json` do not exist as files, so try_files rewrote
	# them to `/index.html` and the proxy matchers - which test the path - then
	# matched nothing. Every API call and the whole content registry came back
	# as the client's own HTML, with status 200.
	#
	# `handle` blocks are mutually exclusive and evaluated in the order written,
	# which is the construct that means what this file looks like it means.
	# Caught by the dry run in ops/oracle/README.md; it is invisible to
	# `caddy validate`, which called the broken version valid.
	#
	# The client and the server share one origin and collide at exactly one
	# path: the WebSocket connects to "/", and "/" is also where index.html
	# lives. So the upgrade is matched by its HEADERS, first, before any path
	# routing gets a chance to serve a page to it.
	#
	# Same-origin is worth the care - no CORS relationship to configure between
	# the two halves, and one certificate instead of two.
	# The response carried NO security headers at all - checked against the
	# live site, not assumed. Each of these closes something specific:
	#
	#   HSTS            the first visit can still be intercepted over http://,
	#                   and a redirect does not prevent that - this makes the
	#                   browser refuse http for this host afterwards. One year,
	#                   which is what preload lists ask for, and safe here
	#                   because there is nothing on this host that is not https.
	#   nosniff         stops a browser deciding a .json or a user upload is
	#                   really HTML and running it.
	#   frame-ancestors an idle game is exactly the kind of page someone frames
	#                   invisibly to steal clicks on. Nothing needs to embed it.
	#   Referrer-Policy account pages should not leak their path to whatever a
	#                   player clicks through to.
	#   Permissions     the game asks for no camera, microphone or location, so
	#                   saying so removes the question.
	#
	# No Content-Security-Policy yet, deliberately: the bundle inlines what Vite
	# inlines and a CSP written blind breaks the page in ways that look like
	# random bugs. It wants a pass with the built output in front of us.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}

	# Modul: DEFINED HERE, at the site level, and used inside the static handle
	# below. Named matchers cannot be declared inside a handle block - Caddy
	# accepts the file and `caddy validate` calls it valid, and the header
	# simply never appears on a response. Diagnosed by curl -I after a reload
	# that reported success.
	@immutable path /assets/* /sprites/*
	@html path / /index.html

	# Modul: AT THE SITE LEVEL, beside the security headers that demonstrably
	# work - not inside the static `handle`. Placed there they were accepted,
	# validated and reloaded without complaint, and never appeared on a single
	# response. The site-level form is the one this file already proves out.
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header @html Cache-Control "no-cache"

	# Modul: THE LOADING SCREEN AND THE ICONS, cached for 30 days. They had no
	# Cache-Control at all, so every visit re-asked for ~440 KB of loading art
	# (PageSpeed, 2026-10-09). Not `immutable` like /assets/*: these names
	# carry no content hash, so a cached copy CAN be wrong - change the art
	# under a new file name (landscape-1920.avif -> landscape-1920b.avif)
	# rather than in place, or returning players see the old picture for up
	# to a month.
	@longlived path /loading/* /icons/*
	header @longlived Cache-Control "public, max-age=2592000"

	# Modul: A MISSING FILE IS A 404, NOT THE GAME. The SPA fallback below
	# answered every unknown path with index.html and 200, so /ai-catalog.json
	# came back as HTML and PageSpeed reported "Malformed JSON", and a missing
	# /sprites/... icon was served as a web page under an immutable cache
	# header. The client routes by hash, never by path, so a path that ends in
	# a file extension and is not on disk can only be a missing file.
	# Site level for the same reason as @immutable above.
	@missingFile {
		path_regexp \.[A-Za-z0-9]+$
		not file {
			root /srv
		}
	}

	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @websocket {
		reverse_proxy app:8080 {
			# Long-lived sockets. An idle game's connection is meant to stay
			# open for hours, and the default read timeout would cut it.
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# Modul: THE OVER-THE-AIR BUNDLES, served as plain static files.
	#
	# A phone's live-update plugin is told the URL of one of these by
	# /api/v1/app/bundle on the app, and downloads it instead of the player
	# reinstalling the APK. They are content-addressed by version in the
	# filename, so like /assets/* they can be cached for ever: a different
	# bundle is a different URL and a cached one can never be wrong.
	#
	# BEFORE the @api block, because that block proxies /api/* to the app and
	# this must not be; and before the SPA fallback, which would otherwise
	# answer a missing bundle with index.html and 200 - the plugin would then
	# unzip a web page and brick itself. A 404 is the answer that lets it give
	# up quietly.
	# Modul: THE ANDROID APP, for a player who found the game in a browser.
	# The login screen links here (client_web/src/lib/net/appDownload.ts). The
	# APK is not in the web image and not in git: it is a release build, signed
	# with the upload key that lives only on the owner's PC, copied to
	# ops/oracle/downloads/ on the box by ops/oracle/publish-apk.ps1.
	#
	# no-cache, NOT immutable like /updates/*: the URL is fixed and the file
	# behind it changes, so a cached copy would hand out an old APK for ever.
	# Before the SPA fallback for the same reason as /updates/*: a missing APK
	# must be a 404, not index.html saved as "folkidle.apk".
	handle_path /download/* {
		root * /downloads
		header Cache-Control "no-cache"
		header /folkidle.apk Content-Type "application/vnd.android.package-archive"
		header /folkidle.apk Content-Disposition "attachment; filename=\"folkidle.apk\""
		file_server
	}

	@updates path /updates/*
	handle @updates {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Modul: /metrics IS NOT PUBLIC. It carries the tick profile, queue depths,
	# session counts and checkpoint failures - nothing personal, but a map of
	# the server for anyone probing it, and no one outside the box reads it.
	# An explicit 404 here, BEFORE @api, rather than dropping it from the
	# matcher: dropped, it would fall to the SPA fallback and answer 200 with
	# index.html, which looks like a working endpoint. Read it on the box:
	#   ssh folkidle-server 'curl -s $(docker inspect -f "{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}" oracle-app-1):8080/metrics'
	handle /metrics {
		respond 404
	}

	# Everything the server owns. /gamedata and /audio are here because the
	# client fetches both from the API (see config.ts GAMEDATA_BASE and
	# audio.ts) - they are NOT part of the static bundle, and letting them fall
	# through to the file server gives a client that loads and then knows about
	# no items or monsters at all.
	#
	# Modul: BUFFERED AT THE EDGE (task 40). Caddy streams a request body to
	# the upstream as it arrives by default, so a client trickling a body a
	# byte at a time held one of the app's handlers for as long as it liked -
	# and before the router went concurrent, the whole server. request_buffers
	# makes Caddy read the whole body (up to 1MB) BEFORE it opens the upstream
	# request, so a slow body occupies Caddy, which is built to take that, and
	# the app only ever sees complete requests. request_body caps it: no API
	# body is more than a few hundred bytes, and the app refuses past 64KB
	# itself (ReadBodyAsync). NOT on the WebSocket handle above - an upgrade
	# has no body to buffer and must stream both ways for hours.
	@api path /api/* /healthz /health/* /gamedata /gamedata/* /audio /audio/*
	handle @api {
		request_body {
			max_size 1MB
		}
		reverse_proxy app:8080 {
			request_buffers 1MB
		}
	}

	# After @api, which owns /gamedata/*.json and the like - those are not
	# files under /srv and must still reach the app.
	# no-cache overrides @immutable: a sprite that is missing today may be
	# deployed tomorrow, and a cached 404 must not outlive that.
	handle @missingFile {
		header Cache-Control "no-cache"
		respond 404
	}

	# The client, and the artwork with it. /sprites lives in the static bundle
	# (vite.config.ts copies the tree in) rather than being proxied to the app,
	# so 214 icon requests never touch .NET.
	handle {
		root * /srv

		# Modul: EVERY DEPLOY WAS INVISIBLE TO A RETURNING PLAYER.
		#
		# Nothing here set Cache-Control, so browsers fell back to HEURISTIC
		# caching: with a Last-Modified and no explicit policy they may hold a
		# document for roughly a tenth of its age without asking. index.html is
		# the one file that names the hashed bundles, so a stale copy of it
		# pins the whole app to the previous build - new CSS deployed, new JS
		# deployed, and the player still served last week's filenames.
		#
		# Reported as "the graphics look exactly the same": they were, because
		# the theme was live on the server and the phone was reading an
		# index.html from before it.
		#
		# The two rules are opposites on purpose, which is the standard shape
		# for a hashed bundle:
		#   - index.html: never trusted without asking. It is 2 kB.
		#   - /assets/*: trusted forever. The filename CONTAINS the content
		#     hash, so a changed file is a different URL and a cached one can
		#     never be wrong.
		try_files {path} /index.html
		file_server
	}
}
