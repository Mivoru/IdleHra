# Caddy over nginx+certbot deliberately: it obtains and renews the certificate
# itself and proxies a WebSocket upgrade without any extra configuration, which
# is most of what nginx would have needed hand-written here.
#
# 92-5-0-94.sslip.io resolves to this machine's public IP by construction -
# sslip.io answers any A-record-shaped name with the address in it. That is the
# whole reason it is here: Let's Encrypt will not issue a certificate for a bare
# IP, the page is served over https, and an https page cannot open a ws://
# socket. Swap this for a real domain by changing this line and rebuilding the
# web image with VITE_FOLKIDLE_SERVER set to match; nothing else refers to it.
#
# Certificate issuance needs port 80 reachable from the internet for the HTTP-01
# challenge - BOTH the instance iptables and the Oracle Security List. Opening
# one and not the other looks exactly like a dead server.

92-5-0-94.sslip.io {
	encode gzip

	# THESE ARE `handle` BLOCKS, AND THAT IS LOAD-BEARING.
	#
	# Caddy orders directives by its own built-in directive order, NOT by the
	# order they appear in the file - and `try_files` sorts BEFORE
	# `reverse_proxy`. Written as bare matchers plus directives, the SPA
	# fallback therefore ran first on every request: `/api/v1/...` and
	# `/gamedata/monsters.json` do not exist as files, so try_files rewrote
	# them to `/index.html` and the proxy matchers - which test the path - then
	# matched nothing. Every API call and the whole content registry came back
	# as the client's own HTML, with status 200.
	#
	# `handle` blocks are mutually exclusive and evaluated in the order written,
	# which is the construct that means what this file looks like it means.
	# Caught by the dry run in ops/oracle/README.md; it is invisible to
	# `caddy validate`, which called the broken version valid.
	#
	# The client and the server share one origin and collide at exactly one
	# path: the WebSocket connects to "/", and "/" is also where index.html
	# lives. So the upgrade is matched by its HEADERS, first, before any path
	# routing gets a chance to serve a page to it.
	#
	# Same-origin is worth the care - no CORS relationship to configure between
	# the two halves, and one certificate instead of two.
	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @websocket {
		reverse_proxy app:8080 {
			# Long-lived sockets. An idle game's connection is meant to stay
			# open for hours, and the default read timeout would cut it.
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# Everything the server owns. /gamedata and /audio are here because the
	# client fetches both from the API (see config.ts GAMEDATA_BASE and
	# audio.ts) - they are NOT part of the static bundle, and letting them fall
	# through to the file server gives a client that loads and then knows about
	# no items or monsters at all.
	@api path /api/* /healthz /health/* /metrics /gamedata /gamedata/* /audio /audio/*
	handle @api {
		reverse_proxy app:8080
	}

	# The client, and the artwork with it. /sprites lives in the static bundle
	# (vite.config.ts copies the tree in) rather than being proxied to the app,
	# so 214 icon requests never touch .NET.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
