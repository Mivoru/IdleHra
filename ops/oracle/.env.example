# Copy to ops/oracle/.env on the box and fill in. NOT committed - it carries
# the database password and the JWT signing key.
#
# JWT_SECRET_KEY MUST BE COPIED FROM THE RENDER SERVICE, not regenerated.
# Tokens are signed with it, so a new secret silently invalidates every
# logged-in player and bounces them to the login screen with no explanation.

DOTNET_ENVIRONMENT=Production

# Supabase, session mode. PORT 5432, NOT 6543.
# The transaction-mode pooler on 6543 passes ordinary queries but hangs EF
# Core's migration path - the first history query dies on the command timeout
# after a reproducible 42 seconds while the same string serves normal traffic
# fine. The direct db.<ref>.supabase.co host is IPv6-only, so the pooler is
# mandatory; it just has to be the right port.
# Npgsql format, not the URI Supabase hands you.
FOLKIDLE_DB_CONN=Host=aws-0-eu-central-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.copqoxrngbvnvnebybzc;Password=REPLACE_ME;SSL Mode=Require;Trust Server Certificate=true

JWT_SECRET_KEY=REPLACE_ME_WITH_THE_RENDER_VALUE

# Unset means NO origin is allowed - it fails closed, and the symptom is
# deceptive: the WebSocket still connects because the upgrade path skips the
# origin check, so it reads as a broken login rather than as CORS.
#
# Same host as the client now: Caddy serves the bundle and proxies the API on
# one origin, so this is that origin. It still has to be set - the browser
# sends an Origin header on a same-origin request too, and the allow-list is
# exact-match with no implicit self.
FOLKIDLE_WEB_ORIGINS=https://92-5-0-94.sslip.io

# Password reset mail. UNSET MEANS THE FLOW REFUSES - production falls back to
# DisabledEmailSender, the endpoint still answers 200 (an unknown address must
# not be distinguishable from a known one) and nothing is sent. Falling back to
# the console sender would print reset links into this box's own log while
# telling players to check their email.
#
# Resend verifies a sending domain by DNS, so this needs a domain you control.
# It does NOT have to be the domain the game is served from - the reset link
# points at FOLKIDLE_WEB_ORIGINS, which is a separate setting.
FOLKIDLE_RESEND_API_KEY=
FOLKIDLE_MAIL_FROM=
