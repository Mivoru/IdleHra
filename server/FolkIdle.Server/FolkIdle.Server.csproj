<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../GameData/**/*.json">
      <Link>GameData/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Modul: web client port, Phase 7. The ten generated sound effects are
       LINKED from the Unity client's Resources folder rather than copied into
       a second location, exactly as TutorialStateMachine.cs is linked into the
       test project. Both clients then play the same bytes, and there is no
       second copy to drift.

       Serving them over HTTP is what lets the browser build have audio at all;
       Unity reads the same files off disk. -->
  <ItemGroup>
    <None Include="../../client/Assets/Resources/Audio/*.wav">
      <Link>Audio/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Modul: the generated 2D artwork, linked for exactly the same reason as
       the audio above - one copy, shared, so the two clients cannot drift on
       what a Magma Wyrm looks like. `.meta` files are Unity's own bookkeeping
       and are excluded; the directory structure is preserved because the
       filenames are only unique within a location folder.

       206 PNGs is a few megabytes, which is fine to copy on build. If this
       grows into hundreds of megabytes, move it behind a CDN rather than
       making the build slower. -->
  <ItemGroup>
    <None Include="../../client/Assets/Images/Sprites/**/*.png" Exclude="../../client/Assets/Images/Sprites/**/*.meta">
      <Link>Sprites/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
