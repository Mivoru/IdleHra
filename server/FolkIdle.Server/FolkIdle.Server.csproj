<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../GameData/**/*.json">
      <Link>GameData/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Modul: web client port, Phase 7. The ten generated sound effects are
       LINKED from the Unity client's Resources folder rather than copied into
       a second location, exactly as TutorialStateMachine.cs is linked into the
       test project. Both clients then play the same bytes, and there is no
       second copy to drift.

       Serving them over HTTP is what lets the browser build have audio at all;
       Unity reads the same files off disk. -->
  <ItemGroup>
    <None Include="../../client/Assets/Resources/Audio/*.wav">
      <Link>Audio/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Modul: the generated 2D artwork, linked for the same reason as the audio
       above - one copy, shared, so nothing can drift on what a Magma Wyrm
       looks like.

       SERVED FROM SpritesWeb, NOT Sprites. The masters in Sprites are
       2048x2048 PNGs totalling 640 MB, drawn at forty pixels; shipping those
       would be a third of a gigabyte of transfer to render icons, and the
       browser's one-step downscale looks worse than a proper resample. Worse,
       113 of them still carry the white background the original cut-out could
       not reach - see tools/clean_sprites.py, which repairs that and writes
       the 50 MB of WebP this serves.

       So: edit or regenerate the masters, then run the cleaner. The masters
       stay the source of truth and are never modified. -->
  <ItemGroup>
    <None Include="../../client/Assets/Images/SpritesWeb/**/*.webp">
      <Link>Sprites/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
