node_modules/
dist/
*.local
smoke-*.png

# Modul: STORE SCREENSHOTS ARE REGENERATED, NOT KEPT.
#
# `npm run screenshots:store` writes eighteen full-resolution PNGs - tens of
# megabytes that change whenever any screen does. Unlike the app icons, nothing
# in the build or in CI reads them: they are uploaded to a store console by
# hand, once per release. The SOURCES that matter (resources/icon.svg and
# resources/splash.svg) are committed; these are output.
resources/store-screenshots/

# Modul: the packaged over-the-air bundle - a ~17 MB build artefact produced by
# scripts/package-bundle.mjs. It is rebuilt from dist/ on every deploy inside
# the web image, so a copy in git would be 17 MB of duplicate that can only go
# stale.
ota/

# Stamped at build time by scripts/stamp-version.mjs - never committed, or the
# build id in the repo would disagree with the one in the deployed bundle.
public/version.json
