    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.1.2",
    "playwright": "^1.62.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.1.38"
  }
}
