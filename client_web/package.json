{
  "name": "folkidle-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:protocol && svelte-check --tsconfig ./tsconfig.json && vite build",
