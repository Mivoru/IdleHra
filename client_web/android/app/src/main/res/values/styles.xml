<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- No windowBackground meant DayNight's default, which is white on a
             phone in light mode: a white flash between the splash and the
             WebView's first paint. -->
        <item name="android:windowBackground">@color/folkidle_window_background</item>
    </style>


    <!-- Android 12+ ignores the splash drawable and draws the launcher icon
         on windowSplashScreenBackground instead, so that colour is set to
         --bg too: the next thing painted is the dark loading screen in
         index.html, and anything lighter flashes between the two. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/folkidle_window_background</item>
    </style>
</resources>